{
  "name": "aries-web",
  "private": true,
  "version": "10.36.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "env:dev": "bash scripts/env/dev.sh",
    "env:prod": "bash scripts/env/prod.sh",
    "dev": "vite",
    "build": "run-s typecheck build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "contract:check": "eslint \"src/api/**/*.{ts,tsx}\" \"src/shared/schemas/**/*.{ts,tsx}\" \"src/constants/error-codes.ts\"",
    "antd:lint": "antd lint src",
    "antd:lint:staged": "antd lint --staged",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "audit:security": "pnpm audit --registry=https://registry.npmjs.org/",
    "lint": "run-s lint:biome eslint",
    "lint:biome": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "E2E_BACKEND_MODE=real playwright test",
    "test:e2e:mock": "E2E_BACKEND_MODE=mock playwright test",
    "test:watch": "vitest",
    "doctor": "react-doctor",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.14-2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "10.75.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "antd": "^6.6.4",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "pinyin-pro": "^3.29.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@ant-design/cli": "6.6.5",
    "@aries/typescript-toolchain": "workspace:*",
    "@biomejs/biome": "^2.5.14",
    "@eslint/js": "^10.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@playwright/test": "^1.63.0",
    "@plugin-web-update-notification/vite": "2.1.3",
    "@rolldown/plugin-babel": "0.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.1.0",
    "npm-run-all": "^4.1.5",
    "react-doctor": "0.9.14",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
