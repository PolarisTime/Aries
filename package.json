{
  "name": "aries-web",
  "private": true,
  "version": "9.2.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "env:dev": "bash scripts/env/dev.sh",
    "env:prod": "bash scripts/env/prod.sh",
    "dev": "vite",
    "build": "run-s typecheck build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "contract:check": "eslint \"src/api/**/*.{ts,tsx}\" \"src/shared/schemas/**/*.{ts,tsx}\" \"src/constants/error-codes.ts\"",
    "audit:security": "pnpm audit --registry=https://registry.npmjs.org/",
    "lint": "run-s lint:biome eslint",
    "lint:biome": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "doctor": "react-doctor",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.1",
    "@ant-design/pro-components": "3.1.14-2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "10.64.0",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^6.5.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.20",
    "es-toolkit": "^1.47.0",
    "i18next": "^26.3.6",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.9",
    "web-vitals": "^5.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@aries/typescript-toolchain": "workspace:*",
    "@biomejs/biome": "^2.4.14",
    "@eslint/js": "^10.0.1",
    "@plugin-web-update-notification/vite": "2.1.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@sentry/vite-plugin": "5.3.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "react-doctor": "0.2.5",
    "semantic-release": "^25.0.5",
    "tailwindcss": "^4.1.17",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  }
}
